{
  "name": "@lksnext/ai-core-tools-base",
  "version": "0.3.0",
  "description": "Mattin AI frontend",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lksnext-ai-lab/ai-core-tools.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/lksnext-ai-lab/ai-core-tools#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:production": "tsc -b --noCheck && vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs && npm run test:types && npm run test:ui",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:scheduled-task-form": "node --test tests/ScheduledTaskFormPage.test.cjs",
    "test:hitl-approval": "node --test tests/HitlApprovalDecisions.test.cjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@types/node": "^24.1.0",
    "axios": "^1.10.0",
    "i18next": "^26.5.11",
    "lucide-react": "^0.511.0",
    "ogl": "^1.0.11",
    "oidc-client-ts": "^3.3.0",
    "react-i18next": "^17.1.9",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-onboarding": "10.6.7",
    "@storybook/addon-themes": "^10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "^16.3.0",
    "jsdom": "29.1.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.1",
    "storybook": "10.6.7",
    "tailwindcss": "^3.4.0",
    "terser": "^5.44.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.3.8",
    "vitest": "4.1.12",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "uri-js": "npm:fast-uri@^3.1.8",
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.2"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "private": true
}
