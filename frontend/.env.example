# MATTIN AI - Frontend Environment Variables

# API Configuration
# Leave EMPTY for both local terminal dev and Docker. The frontend then uses
# same-origin relative paths (/internal, /public, /static, ...) which are routed
# to the backend by the Vite dev-server proxy locally (see vite.config.ts) and
# by Caddy in Docker. This mirrors production and avoids CORS/cookie issues.
# Only set an absolute URL if you point the frontend at a remote, non-proxied backend.
VITE_API_BASE_URL=

# Backend target for the Vite dev-server proxy (local terminal dev only).
# Defaults to http://localhost:8000 when unset.
# VITE_DEV_PROXY_TARGET=http://localhost:8000

# AUTHENTICATION
# OIDC Authentication (EntraID/Azure AD)
# Set to 'false' for local development (simple email-based login)
# Set to 'true' for production (Azure AD OIDC authentication)
VITE_OIDC_ENABLED=false

# AZURE AD CONFIGURATION (only if VITE_OIDC_ENABLED=true)
# Azure AD Authority URL - replace {tenant-id} with your Azure AD tenant ID
# VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/{tenant-id}/v2.0

# Azure AD Application (client) ID from Azure Portal
# VITE_OIDC_CLIENT_ID=your-azure-client-id

# Redirect URI after authentication (must match Azure AD app registration)
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/success

# OIDC Scopes
# VITE_OIDC_SCOPE=openid profile email

# API Audience (Application ID URI configured in Azure AD)
# VITE_OIDC_AUDIENCE=

# DEVELOPMENT MODE
# For local development without Azure AD:
# 1. Set VITE_OIDC_ENABLED=false (default)
# 2. Backend: Set AICT_LOGIN=LOCAL in .env
# 3. Use admin panel to create users or run: python -m utils.seed_dev_users
