# NOTE: this file is NOT consulted by the current frontend image build. Compose
# builds with `context: ..` (repo root) and `dockerfile: frontend/Dockerfile`
# (see docker/docker-compose.yaml), so only the root /.dockerignore applies.
# This file is inert — update the root /.dockerignore instead if you need to
# change what ships in the frontend image.

node_modules
npm-debug.log
.git
.gitignore
dist
.vscode
.DS_Store
**/Thumbs.db

# Environment files - should not be included in Docker images
.env
.env.*
.env.local
.env.development
.env.production

# Build cache
.next/
.cache/

# Test files
**/*.test.js
**/*.test.ts
**/*.spec.js
**/*.spec.ts
coverage/

# Documentation
*.md
docs/
