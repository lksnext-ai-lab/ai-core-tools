# MATTIN AI - Backend Environment Variables

# AUTHENTICATION MODE [REQUIRED]
# LOCAL: Admin-provisioned email+password login (for self-hosted/SaaS)
# OIDC:  Microsoft Entra ID / Azure AD (for production)
AICT_LOGIN=LOCAL

# ============================================================================
# LOCAL AUTH MODE — only relevant when AICT_LOGIN=LOCAL
# All variables below are OPTIONAL; defaults shown are the code defaults.
# ============================================================================

# Secure flag on the auth cookies (access_token, refresh_token, csrf_token).
# MUST be true in any production deployment that is behind HTTPS (the default).
# Set to false ONLY for plain-http local development; the browser will silently
# refuse to send cookies on HTTP when Secure=true.
# AUTH_COOKIE_SECURE=true

# Access token (JWT) time-to-live in minutes.
# LOCAL_ACCESS_TTL_MINUTES=15

# Refresh token time-to-live in days. After expiry the user must log in again.
# LOCAL_REFRESH_TTL_DAYS=14

# Failed-login lockout: number of consecutive bad passwords before the account
# is locked. The lock duration doubles with each subsequent lockout attempt.
# LOCAL_LOCKOUT_THRESHOLD=5

# Base lockout duration in seconds for the first lockout. Subsequent lockouts
# follow an exponential back-off: base * 2^(lockout_count - 1).
# LOCAL_LOCKOUT_BASE_SECONDS=60

# ============================================================================
# SMTP — optional email relay for LOCAL auth "set password" flows.
# When SMTP_HOST AND SMTP_FROM are both unset the app falls back to a
# NoopEmailSender that logs the set-password link to the backend log instead
# of emailing it. SMTP is therefore entirely OFF by default — no mail server
# is required to run LOCAL auth. Uncomment and fill in only when you want
# emails to be delivered.
# ============================================================================
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASSWORD=your-smtp-password-here    # Never logged; treated as a secret
# SMTP_TLS=true
# SMTP_FROM=no-reply@example.com
# SMTP_TIMEOUT_SECONDS=10

# AI SERVICE API KEYS [OPTIONAL]
# You can configure API keys here or from the web interface.
# Only needed when you want to use AI models.
# OpenAI API Key (required for GPT models)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Key (required for Claude models)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# Mistral API Key (required for Mistral models)
MISTRAL_API_KEY=your-mistral-api-key-here

# LANGSMITH CONFIGURATION (Optional - LLM observability)
# Two modes are supported:
#   1) Per-App (recommended): each App stores its own key via UI (App Settings).
#      Variables below are IGNORED for apps that already have a key configured.
#   2) Global fallback: when an App has no key AND LANGSMITH_TRACING is truthy,
#      these env vars are used. Useful for local development.
#
# IMPORTANT — regions: LangSmith hosts EU accounts on a separate endpoint.
# If your LangSmith account was created from the EU (smith.langchain.com may
# redirect to eu.smith.langchain.com), set LANGSMITH_ENDPOINT to the EU URL.
# Using the wrong region returns 403 Forbidden on every API call except /info.
#   US: https://api.smith.langchain.com  (default)
#   EU: https://eu.api.smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mattinai-dev

# DATABASE CONFIGURATION
# Option 1: Use direct database URL (recommended for simple setups)
SQLALCHEMY_DATABASE_URI=postgresql://username:password@localhost:5432/dbname

# Option 2: Use separate database variables (recommended for production)
DATABASE_USER=your_db_user
DATABASE_PASSWORD=your_db_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=your_database_name

# APPLICATION CONFIGURATION
APP_TITLE=IA Core Tools API
APP_DESCRIPTION=Modern FastAPI backend for IA Core Tools
APP_VERSION=2.0.6
ROOT_MESSAGE=IA Core Tools FastAPI Backend

# Application mode: ONLINE or SELF-HOSTED
AICT_MODE=SELF-HOSTED

# Comma-separated list of omniadmin emails
AICT_OMNIADMINS=admin1@example.com,admin2@example.com

# AUTHENTICATION & OAUTH (lks-idprovider)
# Azure EntraID (formerly Azure AD) Configuration
ENTRA_TENANT_ID=your-tenant-id-here
ENTRA_CLIENT_ID=your-client-id-here
ENTRA_CLIENT_SECRET=your-client-secret-here

# Token type to accept and validate
# ID_TOKEN: For OIDC authentication (aud=client_id) - No "Expose an API" needed
# ACCESS_TOKEN: For OAuth 2.0 authorization (aud=api://client_id) - Requires "Expose an API" in Azure
ENTRA_TOKEN_TYPE=ACCESS_TOKEN

# JWT validation settings
ENTRA_VALIDATE_AUDIENCE=true
ENTRA_VALIDATE_ISSUER=true
ENTRA_LEEWAY=0

# Microsoft Graph API version (v1.0 or beta)
ENTRA_API_VERSION=v1.0

# CORS & FRONTEND CONFIGURATION
FRONTEND_URL=http://localhost:5173

# OIDC Authentication: Enable OIDC (EntraID) authentication
# When true: Uses EntraID OIDC authentication (production)
# When false: Uses simple JWT tokens for development (dev mode)
OIDC_ENABLED=false

# Secret key for JWT token signing — REQUIRED, no default.
# The application refuses to start if this value is absent, too short, or
# matches known-insecure placeholder values (the validator in
# backend/utils/secret_key.py checks at startup).
# Generate a strong value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# WARNING: rotating this value invalidates ALL existing sessions (every user
# will be logged out) because the signature of every outstanding JWT will
# immediately fail verification.
SECRET_KEY=

# DEV MODE AUTHENTICATION SETUP
# 1. Set OIDC_ENABLED=false in this file
# 2. Seed test users: python -m utils.seed_dev_users
# 3. Start backend: uvicorn main:app --reload
# 4. Frontend: Set VITE_OIDC_ENABLED=false in frontend/.env
# 5. Login with any seeded user email (e.g., admin@example.com)
#
# Note: Only users with emails in the database can login in dev mode.
# Run seeding script to create default test users.

# CORS Origins (only used if OIDC_ENABLED=false)
CORS_ORIGIN_DEV_SERVER=http://localhost:5173
CORS_ORIGIN_DEV_SERVER_ALT=http://127.0.0.1:5173
CORS_ORIGIN_DOCKER=http://localhost:3000
CORS_ORIGIN_DOCKER_ALT=http://127.0.0.1:3000
CORS_ORIGIN_DEV_8080=http://localhost:8080
CORS_ORIGIN_DEV_8080_ALT=http://127.0.0.1:8080
CORS_ORIGIN_VITE_PREVIEW=http://localhost:4173
CORS_ORIGIN_VITE_PREVIEW_ALT=http://127.0.0.1:4173

LOG_LEVEL=INFO
LOG_DIR=logs

DOWNLOADS_PATH=./app/downloads/
IMAGES_PATH=./app/images/
REPO_BASE_FOLDER=./app/repositories/
TEMP_DIR=data/temp/uploads/

# FILE LIFECYCLE CLEANUP (agent uploads under data/tmp/)
# The background worker (services.file_cleanup_worker) sweeps stale uploads
# so a high-volume Vision-style agent on a fixed API key cannot fill the disk.
#
# - Ephemeral uploads (no agent memory or no conversation_id) live under
#   data/tmp/ephemeral/ and are normally removed at the end of each chat
#   request. The orphan sweep is a defensive backstop for crashed requests.
# - Persistent uploads (agent has memory AND conversation_id) live under
#   data/tmp/persistent/ and expire after TMP_PERSISTENT_TTL_DAYS of
#   inactivity, mirroring the OpenAI Threads convention.
#
# Defaults are safe; uncomment only to override.
# TMP_PERSISTENT_TTL_DAYS=7
# TMP_EPHEMERAL_ORPHAN_HOURS=1
# TMP_CLEANUP_INTERVAL_MINUTES=60
# TMP_CLEANUP_ENABLED=True

# UVICORN PROCESS POOL (Docker only — local `uvicorn --reload` ignores these)
# Each worker is a full Python process loading FastAPI + SQLAlchemy +
# LangChain (~0.5–1.5 GB RSS). Default of 2 fits a single-tenant box with
# 4 GB free; bump to 4 on a production server with >= 8 GB free for the
# backend, drop to 1 on dev/demo hosts. The DB pool size is per-worker,
# so total connections = UVICORN_WORKERS * pool_size.
#
# Note on startup logs: with N workers you will see N consecutive
# "Application startup complete" lines a few seconds apart — each worker
# runs its own lifespan in its own process. That is expected, not a
# crash. The cleanup worker only runs in one of them (leader election
# via fcntl.flock on $TMP_BASE_FOLDER/.cleanup.lock); the others log
# "another worker holds the leader lock; not starting".
# UVICORN_WORKERS=2
# UVICORN_LIMIT_CONCURRENCY=100

PERMANENT_SESSION_LIFETIME_MINUTES=30

# Internal API Documentation
INTERNAL_API_TITLE=IA Core Tools - Internal API
INTERNAL_API_VERSION=2.0.0
INTERNAL_API_DESCRIPTION=Internal API for frontend-backend communication
INTERNAL_DOCS_OPENAPI_URL=/openapi-internal.json
INTERNAL_DOCS_TITLE=Internal API Docs
INTERNAL_DOCS_PATH=/docs/internal

# Public API Documentation
PUBLIC_API_TITLE=IA Core Tools - Public API
PUBLIC_API_VERSION=1.0.0
PUBLIC_API_DESCRIPTION=Public API for external applications
PUBLIC_DOCS_OPENAPI_URL=/openapi-public.json
PUBLIC_DOCS_TITLE=Public API Docs
PUBLIC_DOCS_PATH=/docs/public
