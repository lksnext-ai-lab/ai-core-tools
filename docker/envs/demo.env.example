# ============================================================================
# DEMO — la develop de verdad, para enseñar Mattin a clientes en vivo.
#
# Regla: aquí SOLO se pullea, nunca se hace --build. La gracia de este entorno
# es que muestra exactamente la imagen que publica CI para `develop`, no tu
# working tree a medio terminar.
#
#   .\mattin.ps1 update demo     # pull + recrear = demo a la última
#   .\mattin.ps1 open demo
#
# Sus datos (apps, agentes, silos de demo) persisten entre `update`s: el
# volumen de Postgres es suyo y no lo toca ningún otro entorno.
# ============================================================================
COMPOSE_PROJECT_NAME=mattin-demo
HTTP_PORT=8080
FRONTEND_URL=http://localhost:8080
IMAGE_TAG=develop
TEST_DB_PORT=5440

LANGSMITH_PROJECT=mattin-demo
