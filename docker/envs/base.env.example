# ============================================================================
# BASE — valores compartidos por TODOS los entornos locales.
# Copiar a envs/base.env (gitignored) y rellenar.
#
# Se carga primero; cada envs/<entorno>.env lo sobreescribe (el último
# --env-file gana). Ver docker/README.md § Multi-entorno.
# ============================================================================

# Credenciales de proveedores LLM — las mismas en todos los entornos.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

AICT_OMNIADMINS=mlonbide@lksnext.com

# Cada entorno tiene su propio Postgres (volumen namespaced por project name),
# así que la misma credencial en todos no crea acoplamiento.
DATABASE_USER=mattin
DATABASE_PASSWORD=
DATABASE_NAME=mattin_ai
# Optional: defaults to the application database, using the DBOS schema.
# DBOS_DATABASE_URL=postgresql://mattin:<password>@postgres:5432/mattin_ai
AICT_MIN_SCHEDULE_INTERVAL_SECONDS=60

AICT_LOGIN=LOCAL
# HTTP plano en local: el navegador no manda cookies Secure sobre http://
AUTH_COOKIE_SECURE=false
SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

AICT_MODE=SELF-HOSTED
REPO_BASE_FOLDER=./data/repositories

# Ficheros de repositorios en volumen nombrado en vez del bind mount por
# defecto (../backend/data). Compose lo prefija con el project name, así que
# cada entorno tiene los suyos y no se pisan los 800 MB de uno con otro.
BACKEND_DATA=backend-data
BACKEND_LOGS=backend-logs
VECTOR_DB_TYPE=PGVECTOR
QDRANT_URL=http://qdrant:6333

LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
VITE_OIDC_ENABLED=false
