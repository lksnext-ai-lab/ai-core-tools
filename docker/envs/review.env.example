# ============================================================================
# REVIEW — la rama de otra persona. EFÍMERO.
#
#   git fetch origin pull/<n>/head:pr-<n>
#   git switch pr-<n>
#   .\mattin.ps1 rebuild review
#   ...  revisar  ...
#   .\mattin.ps1 destroy review
#
# Destruirlo al terminar no es limpieza: es lo que hace honesta la siguiente
# revisión. Sobre BD vacía compruebas que SUS migraciones corren de cero, no
# que corren sobre los restos que dejó la PR anterior.
#
# Separado de `dev` a propósito — revisar la PR de alguien no debería
# obligarte a tirar tu propia base de datos de trabajo.
# ============================================================================
COMPOSE_PROJECT_NAME=mattin-review
HTTP_PORT=8082
FRONTEND_URL=http://localhost:8082
IMAGE_TAG=local-review
TEST_DB_PORT=5442

LANGSMITH_PROJECT=mattin-review
