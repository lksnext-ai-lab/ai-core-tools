# ============================================================================
# DEV — tu working tree. Lo que estás implementando tú ahora mismo.
#
#   .\mattin.ps1 rebuild dev     # build desde el código de tu rama actual
#
# La BD es desechable: rómpela, migra hacia atrás, `destroy dev` y vuelve a
# empezar. Nada de lo que hay aquí le importa a nadie más.
# ============================================================================
COMPOSE_PROJECT_NAME=mattin-dev
HTTP_PORT=8081
FRONTEND_URL=http://localhost:8081

# Tag propio, no negociable: el servicio `backend` etiqueta lo que construye
# como mattinai-backend:${IMAGE_TAG}. Con IMAGE_TAG=develop, un --build aquí
# machacaría la imagen :develop que usa el entorno demo.
IMAGE_TAG=local-dev

# El puerto que pyproject.toml espera para la suite de tests.
TEST_DB_PORT=5433

LANGSMITH_PROJECT=mattin-dev
