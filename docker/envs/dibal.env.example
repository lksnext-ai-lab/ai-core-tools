# ============================================================================
# DIBAL — cliente con versión CONGELADA. Plantilla del patrón "un entorno por
# cliente": copia este fichero para el siguiente cliente, o usa
# `.\mattin.ps1 new <cliente> -Type cliente`.
#
# IMAGE_TAG se pinea al tag/SHA exacto que corre en el cliente y no se toca
# salvo decisión explícita de actualizarle. Razón concreta:
# backend/Dockerfile arranca con `alembic upgrade head`, así que levantar aquí
# una imagen más nueva MIGRA su base de datos, y el downgrade no siempre
# recupera los datos.
#
#   .\mattin.ps1 up dibal        # reproducir lo que ve el cliente
# ============================================================================
COMPOSE_PROJECT_NAME=mattin-dibal
HTTP_PORT=8090
FRONTEND_URL=http://localhost:8090

# Sustituir por el tag real que corre en Dibal (sha-xxxxxxx o vX.Y.Z).
IMAGE_TAG=sha-XXXXXXX
TEST_DB_PORT=5443

LANGSMITH_PROJECT=mattin-dibal
