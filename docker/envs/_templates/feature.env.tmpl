# ============================================================================
# __NAME__ — entorno de feature. Build desde el working tree.
# Creado con: .\mattin.ps1 new __NAME__ -Type feature
#
#   git switch <la-rama>
#   .\mattin.ps1 rebuild __NAME__
#   .\mattin.ps1 destroy __NAME__     # al terminar
# ============================================================================
COMPOSE_PROJECT_NAME=mattin-__NAME__
HTTP_PORT=__PORT__
FRONTEND_URL=http://localhost:__PORT__

# Tag propio para que un --build aquí no machaque la imagen de otro entorno.
IMAGE_TAG=local-__NAME__
TEST_DB_PORT=__TESTPORT__

LANGSMITH_PROJECT=mattin-__NAME__
