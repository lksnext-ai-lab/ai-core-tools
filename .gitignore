# Spec-kit
.github/agents/speckit.*
prompts/
specs/
.specify/

# Claude Code agent system: ship the agents/commands/skills/hooks,
# but keep per-run artifacts and personal settings out of git.
/.claude/specs/
/.claude/agent-memory/
**/.claude/agent-memory/
/.claude/settings.local.json

# Codex agent system: ship AGENTS.md, .codex/agents and .agents/skills,
# but keep per-run specs and personal config out of git.
/.codex/specs/
/.codex/config.local.toml

# Local Docker configuration and database dumps
/docker/docker-compose.override.yml

# Entornos Docker locales: un .env por entorno, con secretos. Las plantillas
# .env.example sí se versionan.
/docker/envs/*.env
!/docker/envs/*.env.example

